---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import { Badge } from "@/ui/badge";
import { Button } from "@/ui/button";
import {
  Card,
  CardAction,
  CardContent,
  CardDescription,
  CardFooter,
  CardHeader,
  CardTitle,
} from "@/ui/card";
import { Separator } from "@/ui/separator";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@/ui/tabs";
import { BuildSwitcher } from "./_home/BuildSwitcher";
import { highlight } from "./_home/highlight";

const { config } = data;
const repoUrl = "https://github.com/ryuzcorp/oxide";
const files = [
  {
    name: "client.ts",
    html: highlight(
      `// Looks local. Runs on the server.
// Your server code never reaches the browser.
import { create, watch } from "./notes.server";

const note = await create("Ship Oxide");
console.log(note); // { id: "…", title: "Ship Oxide" }

// A function that yields streams live updates to the browser.
for await (const n of await watch()) console.log(n);`,
      "ts",
    ),
  },
  {
    name: "notes.server.ts",
    html: highlight(
      `// Your backend logic lives here. Talk to a database,
// call an API — it stays on the server.
import { useRequest } from "oxidejs";
import type { ActionOptions } from "oxidejs";

export async function create(title: string) {
  return { id: crypto.randomUUID(), title };
}

export async function* watch(_opts?: ActionOptions) {
  const req = useRequest(); // the inbound request
  yield { id: "1", title: "Ship Oxide" };
}`,
      "ts",
    ),
  },
  {
    name: "server.ts",
    html: highlight(
      `// Every request hits this first. Return nothing to let
// static files take over — no extra setup needed.
export default {
  fetch(request: Request) {
    if (new URL(request.url).pathname === "/api/ok")
      return new Response("ok");
  },
};`,
      "ts",
    ),
  },
  {
    name: "index.html",
    html: highlight(
      `<!doctype html>
<html lang="en">
  <body>
    <div id="app"></div>
    <script type="module" src="/src/client.ts"></script>
  </body>
</html>`,
      "html",
    ),
  },
  {
    name: "vite.config.ts",
    html: highlight(
      `import { defineConfig } from "vite";
import oxide from "oxidejs/vite";

export default defineConfig({
  plugins: [oxide()],
});`,
      "ts",
    ),
  },
];
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  page={{
    title: "Oxide - The backend unframework",
    description: config.description,
    route: "/",
  }}
  themeMode={config.theme.mode}
  fontCssVars={data.fontCssVars}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/opengraph-image.png"
  ogImageAlt="Oxide — The backend unframework"
  ogImageSize={{ width: 1200, height: 630 }}
>
  <div class="relative overflow-hidden">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-[32rem] bg-[radial-gradient(ellipse_at_top,color-mix(in_oklch,var(--color-accent)_18%,transparent),transparent_60%)]"
    >
    </div>

    <section class="relative mx-auto max-w-5xl px-6 pt-20 pb-16 sm:pt-28">
      <Badge shape="pill" variant="secondary">Alpha</Badge>
      <h1
        class="mt-5 max-w-3xl text-balance font-semibold text-4xl text-foreground tracking-tight sm:text-6xl"
      >
        The backend unframework.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted-foreground leading-relaxed">
        Ship a backend from the bundler you already use. Call the server from
        the client like a function.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <Button as="a" href="/getting-started" size="lg">Get started</Button>
        <Button
          as="a"
          href={repoUrl}
          rel="noreferrer"
          size="lg"
          target="_blank"
          variant="outline">View on GitHub</Button
        >
      </div>
    </section>

    <section class="relative mx-auto max-w-5xl px-6 pb-20">
      <Card>
        <CardHeader>
          <CardTitle>A server, an action, a page, and the plugin.</CardTitle>
          <CardDescription>That's the whole app. The plugin wires up your server actions for you.</CardDescription>
          <CardAction>
            <Button as="a" target="_blank" rel="noopener noreferrer" href="https://stackblitz.com/github/ryuzcorp/oxide/tree/main/templates/tasks?file=src%2Ftasks.server.ts" size="sm" type="button" variant="secondary">Run</Button>
          </CardAction>
        </CardHeader>
        <CardContent>
          <Tabs defaultValue={files[0].name}>
            <TabsList class="h-auto w-full justify-start overflow-x-auto overflow-y-hidden pb-1.5" size="sm" variant="line">
              {
                files.map((file) => (
                  <TabsTrigger class="flex-none font-mono" value={file.name}>
                    {file.name}
                  </TabsTrigger>
                ))
              }
            </TabsList>
            {
              files.map((file) => (
                <TabsContent value={file.name}>
                  <div
                    class="overflow-x-auto pt-4 font-mono text-[13px] leading-7 [-webkit-text-size-adjust:100%] [text-size-adjust:100%]"
                    set:html={file.html}
                  />
                </TabsContent>
              ))
            }
          </Tabs>
        </CardContent>
      </Card>
    </section>
  </div>

  <section class="mx-auto max-w-5xl px-6 pb-20">
    <h2
      class="max-w-2xl text-balance font-semibold text-3xl text-foreground tracking-tight"
    >
      It guides you. It doesn't frame you.
    </h2>
    <div class="mt-10 grid gap-4 sm:grid-cols-3">
      <Card>
        <CardHeader>
          <CardTitle>Server code stays put</CardTitle>
          <CardDescription>
            Write a function on the server, call it from the browser like it's
            local. The code never ships to the client, and the types line up.
          </CardDescription>
        </CardHeader>
      </Card>
      <Card>
        <CardHeader>
          <CardTitle>Live updates</CardTitle>
          <CardDescription>
            Export a generator and the browser gets a live stream. Stop it
            anytime with an abort signal.
          </CardDescription>
        </CardHeader>
      </Card>
      <Card>
        <CardHeader>
          <CardTitle>Run it anywhere</CardTitle>
          <CardDescription>
            A VPS, or celld — a self-hosted alternative to Cloudflare Workers.
            Vite or Rsbuild. Your tools, your call.
          </CardDescription>
        </CardHeader>
      </Card>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-20">
    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div>
        <h2 class="font-semibold text-3xl text-foreground tracking-tight">
          Keep your bundler. Add one plugin.
        </h2>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          Vite or Rsbuild. Switch the import. Keep the rest. One build, one
          folder to ship:
        </p>
        <pre class="mt-4 rounded-lg border border-border bg-muted/50 p-4 font-mono text-[13px] leading-6 text-muted-foreground"><code>dist/
├── client/        # if you have a page
└── server.js      # your backend</code></pre>
        <p class="mt-4 text-muted-foreground leading-relaxed">
          Build it and run it with <code class="font-mono">vite build &amp;&amp; node dist/server.js</code>. Actions run on
          <a class="underline-offset-4 hover:text-foreground hover:underline ml-1" href="/tacho/overview">tacho</a>, the RPC layer that ships with it.
        </p>
        <Button as="a" class="mt-6 pl-0" href="/oxide/quickstart" variant="link">
          Read the quickstart →
        </Button>
      </div>
      <BuildSwitcher client:visible />
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pb-24">
    <Card>
      <CardHeader>
        <CardTitle>Your backend can start this small.</CardTitle>
        <CardDescription>
          Install Oxide, add the plugin, write an action.
        </CardDescription>
      </CardHeader>
      <CardFooter>
        <Button as="a" href="/getting-started" size="lg">Get started</Button>
      </CardFooter>
    </Card>
  </section>

  <footer
    slot="footer"
    class="border-border border-t px-6 py-8 text-muted-foreground text-sm"
  >
    <div
      class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3"
    >
      <span>
        Oxide · Built by the team behind{" "}
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="https://ilha.build/" rel="noreferrer" target="_blank">Ilha</a>
      </span>
      <div class="flex h-5 items-center gap-3">
        <Button as="a" href="/getting-started" variant="link">Docs</Button>
        <Separator orientation="vertical" />
        <Button as="a" href={repoUrl} rel="noreferrer" target="_blank" variant="link"
          >GitHub</Button
        >
      </div>
    </div>
  </footer>
</PageLayout>
