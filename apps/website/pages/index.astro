---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import { highlight } from "./_home/highlight";

const { config } = data;
const repoUrl = "https://github.com/ryuzcorp/oxide";
const files = [
  {
    html: highlight(
      `// Looks local. Runs on the server.
// Your server code never reaches the browser.
import { create, watch } from "./notes.server";

const note = await create("Ship Oxide");
console.log(note); // { id: "…", title: "Ship Oxide" }

// Stream actions return an async generator after await.
for await (const n of await watch()) console.log(n);`,
      "ts",
    ),
    name: "client.ts",
  },
  {
    html: highlight(
      `// Only action()-wrapped exports are callable over the wire.
import { action, useRequest } from "oxidejs";

export const create = action(async (title: string) => {
  return { id: crypto.randomUUID(), title };
});

export const watch = action(async function* () {
  useRequest(); // inbound Request inside the stream
  yield { id: "1", title: "Ship Oxide" };
});`,
      "ts",
    ),
    name: "notes.server.ts",
  },
  {
    html: highlight(
      `// Every request hits this first. Return nothing to let
// static files take over — no extra setup needed.
export default {
  fetch(request: Request) {
    if (new URL(request.url).pathname === "/api/ok")
      return new Response("ok");
  },
};`,
      "ts",
    ),
    name: "server.ts",
  },
  {
    html: highlight(
      `<!doctype html>
<html lang="en">
  <body>
    <div id="app"></div>
    <script type="module" src="/src/client.ts"></script>
  </body>
</html>`,
      "html",
    ),
    name: "index.html",
  },
  {
    html: highlight(
      `import { defineConfig } from "vite";
import oxide from "oxidejs/vite";

export default defineConfig({
  plugins: [oxide()],
});`,
      "ts",
    ),
    name: "vite.config.ts",
  },
];

type SysInfo = [key: string, value: string, href?: string, mobileValue?: string];

const sysInfo: SysInfo[] = [
  ["runtime", "node / bun / deno"],
  ["bundler", "vite / rsbuild", "/oxide/quickstart"],
  ["entry", "src/server.ts", "/oxide/server-entry"],
  ["rpc", "effect", "/oxide/server-actions"],
  ["agentic", "llms.txt", "/llms.txt"],
  ["deploy", "vps / celld / cloudflare / vercel", undefined, "vps / workers / vercel"],
];

const btn =
  "btn rounded-none border-2 font-mono uppercase tracking-wide shadow-none";

const bundlers = [
  {
    html: highlight(
      `import { defineConfig } from "vite";
import oxide from "oxidejs/vite";

export default defineConfig({
  plugins: [oxide()],
});`,
      "ts",
    ),
    name: "Vite",
  },
  {
    html: highlight(
      `import { defineConfig } from "@rsbuild/core";
import oxide from "oxidejs/rsbuild";

export default defineConfig({
  plugins: [oxide()],
});`,
      "ts",
    ),
    name: "Rsbuild",
  },
] as const;
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  page={{
    title: "Oxide — Ship the backend, skip the framework",
    description: config.description,
    route: "/",
  }}
  themeMode={config.theme.mode}
  fontCssVars={data.fontCssVars}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/opengraph-image.png"
  ogImageAlt="Oxide — Ship the backend, skip the framework"
  ogImageSize={{ width: 1200, height: 630 }}
>
  <div class="landing-tone hero-bg relative overflow-hidden">
    <section class="relative mx-auto max-w-5xl px-4 pt-12 pb-16 sm:px-6 sm:pt-16">
      <div class="grid items-center gap-12 lg:grid-cols-2">
        <div>
          <h1 class="font-mono text-lg text-foreground">
            <span class="text-primary">oxide</span><span class="text-muted-foreground"
              >@build</span
            >:<span class="text-muted-foreground">~</span>
            <span>ship the backend, skip the framework</span
            ><span
              aria-hidden="true"
              class="ml-2 inline-block h-4 w-2 animate-pulse bg-primary align-middle"
            />
          </h1>
          <p class="mt-4 max-w-108 font-mono text-sm leading-6 text-muted-foreground">
            Turn Vite or Rsbuild into a full-stack build. Import server functions
            in client code with end-to-end types, then deploy one server bundle anywhere.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-3">
            <span class="inline-grid">
              <a
                href="/getting-started"
                class={`${btn} btn-outline sysbox-cta-pending [grid-area:1/1] transition-opacity duration-300 motion-reduce:transition-none`}
              >Start building</a>
              <a
                href="/getting-started"
                class={`${btn} btn-primary sysbox-cta-ready [grid-area:1/1] pointer-events-none opacity-0 transition-opacity duration-300 motion-reduce:transition-none`}
                aria-hidden="true"
                tabindex="-1"
              >Start building</a>
            </span>
            <a
              href={repoUrl}
              rel="noreferrer"
              target="_blank"
              class={`${btn} btn-outline`}
            >Read the source</a>
          </div>
          <p class="mt-6 font-mono text-xs text-muted-foreground/80">
            <span class="text-primary">[ok]</span> 1 plugin · 1 build · 1 deployable tree
          </p>
        </div>

        <div
          class="sysbox-frame w-full max-w-md justify-self-center font-mono text-xs lg:justify-self-end lg:text-sm"
        >
          <div class="sysbox-row px-3 py-2 text-primary" style="--i:0">
            oxide 0.3
          </div>
          <dl class="sysbox-divider m-0 py-2">
            {
              sysInfo.map(([key, value, href, mobileValue], index) => (
                <div
                  class="sysbox-row grid grid-cols-[4.5rem_minmax(0,1fr)] gap-2 px-3 py-1"
                  style={`--i:${index + 1}`}
                >
                  <dt class="text-primary">{key}</dt>
                  <dd class="m-0 min-w-0 text-foreground">
                    {href ? (
                      <a
                        class="underline decoration-current underline-offset-4 hover:text-primary"
                        href={href}
                      >
                        {value}
                      </a>
                    ) : mobileValue ? (
                      <>
                        <span class="lg:hidden">{mobileValue}</span>
                        <span class="hidden lg:inline">{value}</span>
                      </>
                    ) : (
                      value
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </section>

    <section class="relative mx-auto max-w-5xl px-4 pb-20 sm:px-6">
      <div class="ascii-card terminal-win card rounded-none bg-card shadow-none">
        <div class="card-body gap-0 p-0">
          <div class="flex flex-wrap items-start justify-between gap-3 border-b-2 border-border px-4 py-3">
            <div class="min-w-0 space-y-1">
              <h2 class="card-title font-mono text-base uppercase tracking-wide">
                server code in. deployable app out.
              </h2>
              <p class="font-mono text-sm leading-6 text-muted-foreground">
                Five files. No controllers, client SDK, or second build pipeline.
              </p>
            </div>
            <a
              target="_blank"
              rel="noopener noreferrer"
              href="https://stackblitz.com/github/ryuzcorp/oxide/tree/main/templates/simple?file=src%2Fgreet.server.tsx"
              class={`${btn} btn-sm btn-secondary`}
            >▶ run</a>
          </div>

          <div class="tabs tabs-border w-full">
            {
              files.map((file, index) => (
                <>
                  <input
                    type="radio"
                    name="oxide_files"
                    class="tab font-mono text-xs"
                    aria-label={file.name}
                    checked={index === 0}
                  />
                  <div class="tab-content m-0 border-0 p-0">
                    <div
                      class="overflow-x-auto px-4 py-4 font-mono text-sm leading-6 [-webkit-text-size-adjust:100%] [text-size-adjust:100%]"
                      set:html={file.html}
                    />
                  </div>
                </>
              ))
            }
          </div>

          <div
            class="flex items-center gap-2 border-t-2 border-border px-4 py-2 font-mono text-xs text-muted-foreground"
          >
            <span class="text-primary">[ok]</span>
            {files.length} files · effect rpc · chunked streams
          </div>
        </div>
      </div>
    </section>
  </div>

  <section class="landing-tone mx-auto max-w-5xl px-4 pb-20 sm:px-6">
    <h2 class="font-mono text-base uppercase tracking-wide text-muted-foreground">
      <span class="text-primary">[01] //</span> less plumbing. more shipping.
    </h2>
    <div aria-hidden="true" class="ascii-divider mt-3"></div>
    <div class="mt-8 grid gap-4 sm:grid-cols-3">
      <div class="ascii-card card rounded-none bg-card shadow-none">
        <div class="card-body">
          <h3 class="card-title font-mono text-base uppercase tracking-wide">
            <span class="text-primary">▸</span> call server code directly
          </h3>
          <p class="font-mono text-sm leading-6 text-muted-foreground">
            Import a <code>*.server.ts</code> function in the browser. Oxide turns
            the call into typed RPC and keeps the implementation on the server.
          </p>
        </div>
      </div>
      <div class="ascii-card card rounded-none bg-card shadow-none">
        <div class="card-body">
          <h3 class="card-title font-mono text-base uppercase tracking-wide">
            <span class="text-primary">▸</span> stream by yielding
          </h3>
          <p class="font-mono text-sm leading-6 text-muted-foreground">
            Export an async generator to stream values over chunked JSON-RPC.
            Consume it with <code>for await</code> and cancel with an abort signal.
          </p>
        </div>
      </div>
      <div class="ascii-card card rounded-none bg-card shadow-none">
        <div class="card-body">
          <h3 class="card-title font-mono text-base uppercase tracking-wide">
            <span class="text-primary">▸</span> deploy boring output
          </h3>
          <p class="font-mono text-sm leading-6 text-muted-foreground">
            Get one ESM server bundle plus optional client assets. Run it on a VPS,
            celld, Cloudflare, or Vercel.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="landing-tone mx-auto max-w-5xl px-4 pb-20 sm:px-6">
    <div class="grid items-start gap-10 lg:grid-cols-2">
      <div>
        <h2 class="font-mono text-base uppercase tracking-wide text-muted-foreground">
          <span class="text-primary">[02] //</span> one build. no backend side project.
        </h2>
        <div aria-hidden="true" class="ascii-divider mt-3"></div>
        <pre
          class="ascii-card mt-5 overflow-x-auto bg-muted/40 p-4 font-mono text-sm leading-6 text-foreground"
        ><code><span class="text-primary">$</span> tree dist/
dist/
├── client/        <span class="text-muted-foreground"># if you have a page</span>
└── server.js      <span class="text-muted-foreground"># your backend</span></code></pre>
        <p class="mt-4 font-mono text-sm leading-6 text-muted-foreground">
          Build once with <code class="font-mono text-foreground"
            >vite build</code
          >. Oxide emits the browser assets and a server you can run with
          <code class="font-mono text-foreground">node dist/server.js</code>. Server
          actions use typed Effect RPC over HTTP or WebSocket.
        </p>
        <a class="btn btn-link mt-6 pl-0 font-mono uppercase tracking-wide" href="/oxide/quickstart">
          build your first app →
        </a>
      </div>
      <div class="landing-code space-y-4">
        <div class="ascii-card overflow-hidden rounded-none bg-card">
          <div class="tabs tabs-border w-full">
            {
              bundlers.map((bundler, index) => (
                <>
                  <input
                    type="radio"
                    name="oxide_bundler"
                    class="tab font-mono text-xs"
                    aria-label={bundler.name}
                    checked={index === 0}
                  />
                  <div class="tab-content m-0 border-0 p-0">
                    <div
                      class="p-4 font-mono text-[13px] leading-6"
                      set:html={bundler.html}
                    />
                  </div>
                </>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="landing-tone mx-auto max-w-5xl px-4 pb-24 sm:px-6">
    <div class="ascii-card card rounded-none bg-card shadow-none">
      <div class="card-body">
        <h2 class="card-title font-mono text-base uppercase tracking-wide">
          <span class="text-primary">[03] $</span> ship something
        </h2>
        <p class="font-mono text-sm leading-6 text-muted-foreground">
          Add one plugin. Write one server function. Call it from the browser.
          Your backend is ready to ship.
        </p>
        <div class="card-actions">
          <a href="/getting-started" class={`${btn} btn-primary btn-lg`}>Start building</a>
        </div>
      </div>
    </div>
  </section>

  <footer
    slot="footer"
    class="landing-tone border-border border-t px-4 py-8 text-muted-foreground text-sm sm:px-6"
  >
    <div
      class="mx-auto flex max-w-5xl flex-col items-center justify-center gap-3 text-center sm:flex-row sm:justify-between sm:text-left"
    >
      <span class="font-mono">
        oxide · built by the team behind{" "}
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="https://ilha.build/" rel="noreferrer" target="_blank">ilha</a>
      </span>
      <div class="flex h-5 items-center justify-center gap-1 font-mono">
        <a href="/getting-started" class="btn btn-link h-auto min-h-0 px-1 font-mono uppercase tracking-wide">docs</a>
        <div class="divider divider-horizontal mx-0"></div>
        <a href={repoUrl} rel="noreferrer" target="_blank" class="btn btn-link h-auto min-h-0 px-1 font-mono uppercase tracking-wide"
          >github</a
        >
        <div class="divider divider-horizontal mx-0"></div>
        <a href="https://x.com/oxidejs" rel="noreferrer" target="_blank" class="btn btn-link h-auto min-h-0 px-1 font-mono uppercase tracking-wide"
          >x.com</a
        >
        <div class="divider divider-horizontal mx-0"></div>
        <a href="https://discord.gg/WnVTMCTz74" rel="noreferrer" target="_blank" class="btn btn-link h-auto min-h-0 px-1 font-mono uppercase tracking-wide"
          >discord</a
        >
      </div>
    </div>
  </footer>
</PageLayout>

<script>
  const pendingCta = document.querySelector<HTMLElement>(".sysbox-cta-pending");
  const readyCta = document.querySelector<HTMLElement>(".sysbox-cta-ready");
  const lastRow = document.querySelector<HTMLElement>(
    ".sysbox-row:last-child",
  );
  const showPrimary = () => {
    pendingCta?.classList.add("pointer-events-none", "opacity-0");
    pendingCta?.setAttribute("aria-hidden", "true");
    pendingCta?.setAttribute("tabindex", "-1");
    readyCta?.classList.remove("pointer-events-none", "opacity-0");
    readyCta?.removeAttribute("aria-hidden");
    readyCta?.removeAttribute("tabindex");
  };

  if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
    showPrimary();
  } else {
    lastRow?.addEventListener("animationend", showPrimary, { once: true });
  }
</script>

<style>
  .landing-tone {
    --blume-foreground: #0a0a0a;
    --blume-muted-foreground: #525252;
    --ascii-border: #666;
  }

  :global([data-theme="dark"]) .landing-tone {
    --blume-foreground: #fafafa;
    --blume-muted-foreground: #bdbdbd;
    --ascii-border: #525252;
  }

  .terminal-win,
  .landing-code {
    --shj-bg: transparent;
    --shj-fg: var(--blume-foreground);
    --shj-numbers: var(--blume-muted-foreground);
    --shj-cmnt: var(--blume-muted-foreground);
    --shj-bracket: var(--blume-muted-foreground);
    --shj-kwd: var(--blume-accent);
    --shj-oper: var(--blume-accent);
    --shj-esc: var(--blume-accent);
    --shj-class: var(--blume-accent);
    --shj-num: var(--blume-accent);
    --shj-bool: var(--blume-accent);
    --shj-type: var(--blume-accent);
    --shj-section: var(--blume-accent);
    --shj-func: var(--blume-accent);
    --shj-var: var(--blume-foreground);
    --shj-str: var(--blume-foreground);
    --shj-insert: var(--blume-accent);
  }

  .sysbox-frame,
  :global(.ascii-card) {
    position: relative;
    border: 0;
    border-inline: 1px solid var(--ascii-border);
    box-shadow: none;
  }

  .sysbox-frame::before,
  .sysbox-frame::after,
  :global(.ascii-card)::before,
  :global(.ascii-card)::after {
    position: absolute;
    right: 0;
    left: 0;
    z-index: 1;
    height: 1px;
    background: repeating-linear-gradient(
      90deg,
      var(--ascii-border) 0 16px,
      transparent 16px 22px
    );
    box-shadow:
      inset 16px 0 var(--ascii-border),
      inset -16px 0 var(--ascii-border);
    content: "";
    pointer-events: none;
  }

  .sysbox-frame::before,
  :global(.ascii-card)::before {
    top: 0;
  }

  .sysbox-frame::after,
  :global(.ascii-card)::after {
    bottom: 0;
  }

  .sysbox-divider {
    position: relative;
  }

  .sysbox-divider::before,
  .ascii-divider {
    background: repeating-linear-gradient(
      90deg,
      var(--ascii-border) 0 16px,
      transparent 16px 22px
    );
    box-shadow:
      inset 16px 0 var(--ascii-border),
      inset -16px 0 var(--ascii-border);
  }

  .sysbox-divider::before {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 1px;
    content: "";
    pointer-events: none;
  }

  .ascii-divider {
    height: 1px;
  }

  .sysbox-row {
    opacity: 0;
    animation: sysbox-render 250ms ease-out forwards;
    animation-delay: calc(100ms + var(--i) * 90ms);
  }

  @keyframes sysbox-render {
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sysbox-row {
      opacity: 1;
      animation: none;
    }
  }
</style>
