---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import { highlight } from "./_home/highlight";

const { config } = data;
const repoUrl = "https://github.com/ryuzcorp/oxide";
const playgroundUrl =
  "https://stackblitz.com/github/ryuzcorp/oxide/tree/main/templates/simple?file=src%2Fgreet.server.tsx";
const installCmd = "npm i -D oxidejs";

const clientCode = highlight(
  `import { create, watch } from "./notes.server";

// Looks local. Runs on the server.
const note = await create("Ship Oxide");
//    ^? { id: string; title: string }

// Streams arrive as an async generator.
for await (const n of watch()) render(n);`,
  "ts",
);

const serverCode = highlight(
  `import { Effect, Schema } from "effect";
import { action } from "oxidejs";

class Empty extends Schema.TaggedError<Empty>()("Empty", {}) {}

export const create = action(
  (title: string) =>
    Effect.gen(function* () {
      if (!title.trim()) return yield* Effect.fail(new Empty());
      return { id: crypto.randomUUID(), title };
    }),
  { error: Empty },
);

export const watch = action(async function* () {
  yield { id: "1", title: "Ship Oxide" };
});`,
  "ts",
);

const bundlers = [
  {
    html: highlight(
      `import { defineConfig } from "vite";
import oxide from "oxidejs/vite";

export default defineConfig({
  plugins: [oxide()],
});`,
      "ts",
    ),
    name: "vite.config.ts",
  },
  {
    html: highlight(
      `import { defineConfig } from "@rsbuild/core";
import oxide from "oxidejs/rsbuild";

export default defineConfig({
  plugins: [oxide()],
});`,
      "ts",
    ),
    name: "rsbuild.config.ts",
  },
];

const serverEntry = highlight(
  `// Optional. Return nothing to fall
// through to static files.
export default {
  fetch(request: Request) {
    const { pathname } = new URL(request.url);
    if (pathname === "/api/ok")
      return new Response("ok");
  },
};`,
  "ts",
);

const features = [
  {
    body: "Import a *.server.ts export in the browser. Oxide swaps it for a typed RPC stub. The implementation never ships to the client.",
    glyph: "->",
    title: "Call server code directly",
  },
  {
    body: "Export an async generator or an Effect Stream. Values arrive as NDJSON. Break the loop or abort to cancel on the server.",
    glyph: "~>",
    title: "Stream by yielding",
  },
  {
    body: "Fail with a Schema.TaggedError. The client gets the tag and fields back, not a stringly-typed 500.",
    glyph: "!?",
    title: "Typed errors on the wire",
  },
  {
    body: "Actions ride HTTP by default. Flip actions: \"ws\" for one socket per client, with ping, retries, and live queries.",
    glyph: "<>",
    title: "HTTP or WebSocket",
  },
  {
    body: "Calls made in the same tick share one POST with batch(). Results resolve in order. Fewer round trips, same code.",
    glyph: "[]",
    title: "Batch for free",
  },
  {
    body: "On Workers, export workflow(), queue(), or schedule(). Oxide merges the wrangler bindings and exposes start and status over RPC.",
    glyph: "::",
    title: "Durable jobs, one file",
  },
];

const targets = [
  { label: "Node", note: "node dist/server.js" },
  { label: "Bun", note: "bun dist/server.js" },
  { label: "Deno", note: "deno run dist/server.js" },
  { label: "Cloudflare", note: "@cloudflare/vite-plugin" },
  { label: "celld", note: "dist/wrangler.json" },
  { label: "Vercel", note: "fetch handler" },
];

const without = [
  "REST controllers for every call",
  "A hand-written client SDK",
  "Duplicated request / response types",
  "A second build for the backend",
  "A framework that owns your routes",
];

const btn =
  "btn rounded-none border-2 font-mono uppercase tracking-wide shadow-none";
const kicker =
  "font-mono text-xs uppercase tracking-[0.2em] text-muted-foreground";
const sectionTitle =
  "mt-3 font-mono text-2xl font-semibold tracking-tight text-foreground sm:text-3xl";
---

<PageLayout
  site={{ title: config.title, description: config.description }}
  logo={config.logo}
  favicon={config.favicon}
  appleIcon={config.appleIcon}
  banner={config.banner}
  analytics={config.analytics}
  navigation={data.navigation}
  page={{
    title: "Oxide — Ship the backend, skip the framework",
    description: config.description,
    route: "/",
  }}
  themeMode={config.theme.mode}
  fontCssVars={data.fontCssVars}
  searchEnabled={config.search.enabled}
  siteUrl={config.site}
  ogEnabled={config.og.enabled}
  ogImage="/opengraph-image.png"
  ogImageAlt="Oxide — Ship the backend, skip the framework"
  ogImageSize={{ width: 1200, height: 630 }}
>
  <div class="landing-tone">
    <!-- Hero -->
    <section class="hero-grid relative overflow-hidden border-border border-b">
      <div aria-hidden="true" class="hero-glow"></div>
      <div class="relative mx-auto max-w-6xl px-4 pt-16 pb-20 sm:px-6 sm:pt-24 sm:pb-28">
        <div class="grid items-center gap-14 lg:grid-cols-[1.15fr_1fr]">
          <div class="reveal" style="--d:0">
            <a
              href="/oxide/worker"
              class="group inline-flex items-center gap-2 border border-border bg-card/70 px-3 py-1 font-mono text-xs text-muted-foreground backdrop-blur hover:text-foreground"
            >
              <span class="ink-dot" aria-hidden="true"></span>
              new: workflows, queues &amp; cron on Workers
              <span class="transition-transform group-hover:translate-x-0.5">→</span>
            </a>

            <h1
              class="mt-6 font-mono text-4xl font-semibold leading-[1.05] tracking-tight text-foreground sm:text-5xl xl:text-6xl"
            >
              Ship the backend.<br />
              <span class="ink-text">Skip the framework.</span><span
                aria-hidden="true"
                class="caret ml-1 inline-block h-[0.8em] w-[0.45em] translate-y-[0.08em] bg-foreground align-baseline"
              ></span>
            </h1>

            <p class="mt-6 max-w-xl text-base leading-7 text-muted-foreground sm:text-lg">
              Oxide turns Vite or Rsbuild into a full-stack build. Import server
              functions straight into client code with end-to-end types, then deploy
              one boring server bundle anywhere.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a href="/getting-started" class={`${btn} btn-ink`}>Start building →</a>
              <a
                href={playgroundUrl}
                rel="noopener noreferrer"
                target="_blank"
                class={`${btn} btn-outline`}
              >▶ Try it live</a>
            </div>

            <div
              class="install mt-6 inline-flex max-w-full items-center gap-3 border border-border bg-card px-3 py-2 font-mono text-sm"
            >
              <span class="ink-text select-none">$</span>
              <code class="truncate text-foreground">{installCmd}</code>
              <button
                type="button"
                class="copy-btn ml-2 cursor-pointer border-border border-l pl-3 text-xs uppercase tracking-wide text-muted-foreground hover:text-foreground"
                data-copy={installCmd}
                aria-label="Copy install command"
              >copy</button>
            </div>
          </div>

          <!-- Flow diagram -->
          <div class="reveal font-mono text-xs sm:text-sm" style="--d:2">
            <div class="ascii-card bg-card/80 backdrop-blur">
              <div class="flex items-center justify-between border-border border-b px-4 py-2 text-muted-foreground">
                <span>how a call travels</span>
                <span class="ink-text">oxide 0.5</span>
              </div>
              <ol class="m-0 list-none space-y-0 p-0">
                <li class="flow-step" style="--i:0">
                  <span class="flow-tag">browser</span>
                  <code class="text-foreground">await create("Ship Oxide")</code>
                </li>
                <li class="flow-wire" style="--i:1" aria-hidden="true">
                  <span class="packet"></span>
                </li>
                <li class="flow-step" style="--i:2">
                  <span class="flow-tag">wire</span>
                  <code class="min-w-0 truncate text-muted-foreground"
                    >POST /__oxide/action · json-rpc</code
                  >
                </li>
                <li class="flow-wire" style="--i:3" aria-hidden="true">
                  <span class="packet" style="animation-delay:.6s"></span>
                </li>
                <li class="flow-step" style="--i:4">
                  <span class="flow-tag">server</span>
                  <code class="text-foreground">notes.create</code>
                  <span class="ml-auto text-muted-foreground">Effect</span>
                </li>
                <li class="flow-wire" style="--i:5" aria-hidden="true">
                  <span class="packet reverse" style="animation-delay:1.2s"></span>
                </li>
                <li class="flow-step" style="--i:6">
                  <span class="flow-tag ink-bg">result</span>
                  <code class="min-w-0 truncate text-foreground"
                    >{`{ id: "…", title: "Ship Oxide" }`}</code
                  >
                </li>
              </ol>
              <div class="flex flex-wrap gap-x-4 gap-y-1 border-border border-t px-4 py-2 text-muted-foreground">
                <span><span class="ink-text">✓</span> typed end to end</span>
                <span><span class="ink-text">✓</span> no client SDK</span>
                <span><span class="ink-text">✓</span> no routes</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Code split -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <p class={kicker}><span class="ink-text">01</span> / the whole idea</p>
      <h2 class={sectionTitle}>Two files. One function call.</h2>
      <p class="mt-3 max-w-2xl leading-7 text-muted-foreground">
        Write the server function. Import it from the client. Oxide rewrites the
        import into an Effect RPC stub at build time, so types flow through and
        server code stays on the server.
      </p>

      <div class="code-theme mt-10 grid gap-4 lg:grid-cols-2">
        <div class="ascii-card bg-card">
          <div class="win-bar">
            <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>src/client.ts</span>
            <span class="ml-auto text-[10px] uppercase tracking-widest">browser</span>
          </div>
          <div class="overflow-x-auto p-4 font-mono text-[13px] leading-6" set:html={clientCode} />
        </div>
        <div class="ascii-card bg-card">
          <div class="win-bar">
            <span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>src/notes.server.ts</span>
            <span class="ink-text ml-auto text-[10px] uppercase tracking-widest">server only</span>
          </div>
          <div class="overflow-x-auto p-4 font-mono text-[13px] leading-6" set:html={serverCode} />
        </div>
      </div>
      <p class="mt-4 font-mono text-xs text-muted-foreground">
        <span class="ink-text">[ok]</span> Only <code class="text-foreground">action()</code>{" "}
        exports are callable over the wire. Everything else stays server-local.
      </p>
    </section>

    <!-- Features -->
    <section class="border-border border-y bg-muted/30">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <p class={kicker}><span class="ink-text">02</span> / less plumbing</p>
        <h2 class={sectionTitle}>Everything between the click and the database.</h2>
        <div class="mt-10 grid gap-px border border-border bg-border sm:grid-cols-2 lg:grid-cols-3">
          {
            features.map((feature) => (
              <div class="feature group bg-card p-6">
                <span class="feature-glyph" aria-hidden="true">
                  {feature.glyph}
                </span>
                <h3 class="mt-5 font-mono text-sm font-semibold uppercase tracking-wide text-foreground">
                  {feature.title}
                </h3>
                <p class="mt-2 text-sm leading-6 text-muted-foreground">{feature.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <p class={kicker}><span class="ink-text">03</span> / one build</p>
      <h2 class={sectionTitle}>No backend side project.</h2>

      <div class="code-theme mt-10 grid gap-4 lg:grid-cols-3">
        <div class="step ascii-card bg-card">
          <div class="win-bar"><span class="step-num">1</span><span>Add the plugin</span></div>
          <div class="tabs tabs-border w-full">
            {
              bundlers.map((bundler, index) => (
                <>
                  <input
                    type="radio"
                    name="oxide_bundler"
                    class="tab font-mono text-xs"
                    aria-label={bundler.name}
                    checked={index === 0}
                  />
                  <div class="tab-content m-0 border-0 p-0">
                    <div
                      class="overflow-x-auto p-4 font-mono text-[13px] leading-6"
                      set:html={bundler.html}
                    />
                  </div>
                </>
              ))
            }
          </div>
        </div>

        <div class="step ascii-card bg-card">
          <div class="win-bar"><span class="step-num">2</span><span>src/server.ts</span></div>
          <div class="overflow-x-auto p-4 font-mono text-[13px] leading-6" set:html={serverEntry} />
        </div>

        <div class="step ascii-card bg-card">
          <div class="win-bar"><span class="step-num">3</span><span>Build &amp; run</span></div>
          <pre
            class="m-0 overflow-x-auto p-4 font-mono text-[13px] leading-6 text-foreground"
          ><code><span class="ink-text">$</span> vite build

<span class="ink-text">$</span> tree dist/
dist/
├── client/   <span class="text-muted-foreground"># if you have a page</span>
└── server.js <span class="text-muted-foreground"># your backend</span>

<span class="ink-text">$</span> node dist/server.js
<span class="text-muted-foreground">oxidejs listening on 3000</span></code></pre>
        </div>
      </div>

      <a class="btn btn-link mt-6 pl-0 font-mono uppercase tracking-wide" href="/oxide/quickstart">
        Read the quickstart →
      </a>
    </section>

    <!-- Without / Deploy -->
    <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-28">
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class={kicker}><span class="ink-text">04</span> / what you skip</p>
          <h2 class={sectionTitle}>Delete the glue code.</h2>
          <ul class="mt-8 space-y-3 p-0">
            {
              without.map((item) => (
                <li class="flex items-baseline gap-3 font-mono text-sm">
                  <span class="ink-text select-none">−</span>
                  <span class="text-muted-foreground line-through decoration-muted-foreground/50">
                    {item}
                  </span>
                </li>
              ))
            }
            <li class="flex items-baseline gap-3 pt-2 font-mono text-sm">
              <span class="ink-text select-none">+</span>
              <span class="text-foreground">One plugin. Plain functions. Real types.</span>
            </li>
          </ul>
        </div>

        <div>
          <p class={kicker}><span class="ink-text">05</span> / deploy</p>
          <h2 class={sectionTitle}>Boring output runs anywhere.</h2>
          <div class="mt-8 grid grid-cols-2 gap-px border border-border bg-border sm:grid-cols-3">
            {
              targets.map((target) => (
                <div class="target bg-card px-4 py-5">
                  <div class="font-mono text-sm font-semibold text-foreground">{target.label}</div>
                  <div class="mt-1 truncate font-mono text-[11px] text-muted-foreground">
                    {target.note}
                  </div>
                </div>
              ))
            }
          </div>
          <p class="mt-4 text-sm leading-6 text-muted-foreground">
            One ESM bundle with a standard <code class="font-mono text-foreground">fetch</code>{" "}
            handler. Add a <code class="font-mono text-foreground">wrangler.jsonc</code>{" "}and Oxide
            switches to the Workers preset on its own.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-6xl px-4 pb-24 sm:px-6">
      <div class="cta ascii-card hero-grid relative overflow-hidden bg-card px-6 py-14 text-center sm:px-12 sm:py-20">
        <div aria-hidden="true" class="hero-glow"></div>
        <div class="relative">
          <h2 class="font-mono text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
            Ship something <span class="ink-text">today.</span>
          </h2>
          <p class="mx-auto mt-4 max-w-lg leading-7 text-muted-foreground">
            Add one plugin. Write one server function. Call it from the browser.
            Your backend is ready.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
            <a href="/getting-started" class={`${btn} btn-ink btn-lg`}>Start building →</a>
            <a
              href={repoUrl}
              rel="noopener noreferrer"
              target="_blank"
              class={`${btn} btn-outline btn-lg`}
            >Star on GitHub</a>
          </div>
          <p class="mt-6 font-mono text-xs text-muted-foreground">
            <a class="underline underline-offset-4 hover:text-foreground" href="/llms.txt">llms.txt</a>{" "}
            for your agent · MIT licensed
          </p>
        </div>
      </div>
    </section>
  </div>

  <footer
    slot="footer"
    class="landing-tone border-border border-t px-4 py-8 text-muted-foreground text-sm sm:px-6"
  >
    <div
      class="mx-auto flex max-w-6xl flex-col items-center justify-center gap-3 text-center sm:flex-row sm:justify-between sm:text-left"
    >
      <span class="font-mono">
        oxide · built by the team behind{" "}
        <a class="underline-offset-4 hover:text-foreground hover:underline" href="https://ilha.build/" rel="noopener noreferrer" target="_blank">ilha</a>
      </span>
      <div class="flex h-5 items-center justify-center gap-1 font-mono">
        <a href="/getting-started" class="btn btn-link h-auto min-h-0 px-1 font-mono uppercase tracking-wide">docs</a>
        <div class="divider divider-horizontal mx-0"></div>
        <a href={repoUrl} rel="noopener noreferrer" target="_blank" class="btn btn-link h-auto min-h-0 px-1 font-mono uppercase tracking-wide"
          >github</a
        >
        <div class="divider divider-horizontal mx-0"></div>
        <a href="https://x.com/oxidejs" rel="noopener noreferrer" target="_blank" class="btn btn-link h-auto min-h-0 px-1 font-mono uppercase tracking-wide"
          >x.com</a
        >
        <div class="divider divider-horizontal mx-0"></div>
        <a href="https://discord.gg/WnVTMCTz74" rel="noopener noreferrer" target="_blank" class="btn btn-link h-auto min-h-0 px-1 font-mono uppercase tracking-wide"
          >discord</a
        >
      </div>
    </div>
  </footer>
</PageLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>(".copy-btn")) {
    button.addEventListener("click", async () => {
      const text = button.dataset.copy ?? "";
      try {
        await navigator.clipboard.writeText(text);
        button.textContent = "copied";
      } catch {
        button.textContent = "failed";
      }
      setTimeout(() => {
        button.textContent = "copy";
      }, 1500);
    });
  }
</script>

<style>
  .landing-tone {
    --blume-foreground: #0a0a0a;
    --blume-muted-foreground: #525252;
    --ascii-border: #8a8a8a;
    --ink: oklch(0.48 0.2 272);
    --ink-soft: oklch(0.48 0.2 272 / 0.1);
    --ink-contrast: #fff;
    --grid-line: rgb(0 0 0 / 0.05);
  }

  :global([data-theme="dark"]) .landing-tone {
    --blume-foreground: #fafafa;
    --blume-muted-foreground: #a3a3a3;
    --ascii-border: #4a4a4a;
    --ink: oklch(0.7 0.15 275);
    --ink-soft: oklch(0.7 0.15 275 / 0.16);
    --ink-contrast: #0a0a0a;
    --grid-line: rgb(255 255 255 / 0.05);
  }

  .ink-text {
    color: var(--ink);
  }

  .ink-bg {
    background: var(--ink) !important;
    color: var(--ink-contrast) !important;
    border-color: var(--ink) !important;
  }

  .btn-ink {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--ink-contrast);
  }

  .btn-ink:hover {
    border-color: var(--blume-foreground);
    background: var(--blume-foreground);
    color: var(--blume-background);
  }

  .ink-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--ink);
    box-shadow: 0 0 0 3px var(--ink-soft);
  }

  /* Hero backdrop: faint grid fading out, with a ink glow. */
  .hero-grid {
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 32px 32px;
    background-position: -1px -1px;
  }

  .hero-glow {
    position: absolute;
    inset: -30% -10% auto auto;
    width: 60rem;
    height: 40rem;
    background: radial-gradient(closest-side, var(--ink-soft), transparent);
    pointer-events: none;
  }

  .caret {
    animation: blink 1.1s steps(1) infinite;
    background: var(--ink);
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Syntax colors: monochrome with ink highlights. */
  .code-theme {
    --shj-bg: transparent;
    --shj-fg: var(--blume-foreground);
    --shj-numbers: var(--blume-muted-foreground);
    --shj-cmnt: var(--blume-muted-foreground);
    --shj-bracket: var(--blume-muted-foreground);
    --shj-kwd: var(--ink);
    --shj-oper: var(--blume-muted-foreground);
    --shj-esc: var(--ink);
    --shj-class: var(--blume-foreground);
    --shj-num: var(--ink);
    --shj-bool: var(--ink);
    --shj-type: var(--blume-foreground);
    --shj-section: var(--ink);
    --shj-func: var(--blume-foreground);
    --shj-var: var(--blume-foreground);
    --shj-str: var(--blume-muted-foreground);
    --shj-insert: var(--ink);
  }

  .win-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--ascii-border);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    color: var(--blume-muted-foreground);
  }

  .win-dots {
    display: inline-flex;
    gap: 0.35rem;
  }

  .win-dots i {
    width: 0.55rem;
    height: 0.55rem;
    border: 1px solid var(--ascii-border);
  }

  .win-dots i:first-child {
    background: var(--ink);
    border-color: var(--ink);
  }

  .step-num {
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    background: var(--ink);
    color: var(--ink-contrast);
    font-weight: 600;
  }

  /* Dashed ASCII frame. */
  :global(.ascii-card) {
    position: relative;
    border: 0;
    border-inline: 1px solid var(--ascii-border);
    box-shadow: none;
  }

  :global(.ascii-card)::before,
