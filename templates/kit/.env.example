# Compose / make up defaults. Copy to `.env` to override (gitignored).
#
# Demo only — change every secret before binding ports beyond localhost.

# RustFS S3 API + console credentials
RUSTFS_ACCESS_KEY=kitaccess
RUSTFS_SECRET_KEY=kitsecretkitsecretkitsecret12

# Published ports on the host (LAN-visible if the host firewall allows)
KIT_PORT=8080
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# celld fleet bucket on RustFS (R2 binding FILES uses r2/files/ inside this bucket)
AWS_REGION=us-east-1
CELLD_BUCKET=s3://celld
CELLD_DEPLOY_POLL_S=5

# Better Auth (merged into dist/wrangler.json vars at build)
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:8080
