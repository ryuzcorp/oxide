# Compose / make up defaults. Copy to `.env` to override (gitignored).
#
# Demo only — change every secret before binding ports beyond localhost.

# RustFS S3 API + console credentials
RUSTFS_ACCESS_KEY=kitaccess
RUSTFS_SECRET_KEY=kitsecretkitsecretkitsecret12

# Published ports on the host (LAN-visible if the host firewall allows)
KIT_PORT=8080
RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

# celld fleet bucket on RustFS (R2 binding FILES uses r2/files/ inside this bucket)
AWS_REGION=us-east-1
CELLD_BUCKET=s3://celld

# celld node behavior. The deploy job POSTs /reload, so the poll is only a
# fallback; 300s matches the Noite fleet default.
CELLD_DEPLOY_POLL_S=300
# actions: "ws" — seconds a resident Durable Object may keep old code before a
# forced cutover (WebSockets closed with 1012). 0 forces at adoption.
CELLD_DEPLOY_MAX_AGE_S=60
# Per-node asset cache bound, in bytes (default 256 MiB here; celld's own
# default is 512 MiB). The cache dir is /var/lib/celld/asset-cache.
CELLD_ASSET_CACHE_BYTES=268435456
# Set to 1 only behind a trusted reverse proxy that replaces X-Forwarded-Host
# and X-Forwarded-Proto; otherwise links/redirects get the wrong host/scheme.
CELLD_TRUST_FORWARDED_HEADERS=0
# Node stop bound; compose stop_grace_period (25s) must exceed it.
CELLD_SHUTDOWN_TOTAL_MS=15000
# Where the kit deploy job POSTs after `celld deploy` (compose service name).
CELLD_RELOAD_URL=http://celld:8081/reload

# Better Auth (merged into dist/wrangler.json vars at build)
BETTER_AUTH_SECRET=dev-only-change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:8080
