{
  "extends": "oxidejs/tsconfig",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "ilha",
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "oxidejs": ["../../packages/oxidejs/src/index.ts"],
      "oxidejs/*": ["../../packages/oxidejs/src/*"]
    },
    "types": ["@cloudflare/workers-types", "vite/client"],
    "strictNullChecks": true
  },
  "include": ["src", "vite.config.ts", ".ilha/pages.d.ts"]
}
