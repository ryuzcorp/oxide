{
  "name": "oxidejs",
  "version": "0.2.0",
  "description": "Vite/Rsbuild plugin. One build → dist/server.js + optional client. Server actions via *.server.ts.",
  "keywords": [
    "cloudflare",
    "rsbuild",
    "server-actions",
    "typescript",
    "unplugin",
    "vite"
  ],
  "homepage": "https://github.com/ryuzcorp/oxide/tree/main/packages/oxidejs#readme",
  "bugs": "https://github.com/ryuzcorp/oxide/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuzcorp/oxide.git",
    "directory": "packages/oxidejs"
  },
  "files": [
    "dist",
    "virtual.d.ts",
    "client.d.ts",
    "tsconfig.app.json"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./rsbuild": {
      "types": "./dist/rsbuild.d.mts",
      "import": "./dist/rsbuild.mjs"
    },
    "./virtual": {
      "types": "./virtual.d.ts"
    },
    "./client": {
      "types": "./client.d.ts"
    },
    "./tsconfig": "./tsconfig.app.json"
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "tacho": "^0.4.3"
  },
  "peerDependencies": {
    "@rsbuild/core": "*",
    "crossws": "*",
    "tacho": "*",
    "vite": "*"
  },
  "peerDependenciesMeta": {
    "@rsbuild/core": {
      "optional": true
    },
    "crossws": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "tacho": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
