{
  "name": "tacho",
  "version": "0.6.0",
  "description": "JSON-RPC, but you never write a client.",
  "keywords": [
    "bun",
    "fetch",
    "json-rpc",
    "jsonrpc",
    "rpc",
    "standard-schema",
    "typescript",
    "websocket"
  ],
  "homepage": "https://github.com/ryuzcorp/oxide/tree/main/packages/tacho#readme",
  "bugs": "https://github.com/ryuzcorp/oxide/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryuzcorp/oxide.git",
    "directory": "packages/tacho"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./transport/fetch": {
      "types": "./dist/transport/fetch.d.mts",
      "import": "./dist/transport/fetch.mjs"
    },
    "./transport/ws": {
      "types": "./dist/transport/ws.d.mts",
      "import": "./dist/transport/ws.mjs"
    },
    "./client/http": {
      "types": "./dist/client/http.d.mts",
      "import": "./dist/client/http.mjs"
    },
    "./client/ws": {
      "types": "./dist/client/ws.d.mts",
      "import": "./dist/client/ws.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt --write .",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "latest",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsdown": "^0.22.14",
    "typescript": "^6"
  },
  "peerDependencies": {
    "crossws": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "crossws": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
