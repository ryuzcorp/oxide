{
  "name": "oxide-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun run --filter './packages/*' test",
    "build": "bun run --filter './packages/*' build",
    "release": "bun scripts/release.ts",
    "smoke:celld": "bun scripts/celld-smoke.ts",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "docs:dev": "bun run --filter website dev",
    "docs:build": "bun run --filter website build",
    "docs:verify": "bun run --filter website verify",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "^1.4.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "ultracite": "8.0.0"
  },
  "overrides": {
    "@scalar/json-magic": {
      "undici": "7.30.0"
    },
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    },
    "katex": "0.18.10",
    "lodash-es": "4.18.1",
    "postcss-selector-parser": "7.1.6"
  }
}
