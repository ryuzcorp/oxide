{
  "name": "oxide-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "templates/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun run --filter './packages/*' test",
    "build": "bun run --filter './packages/*' build",
    "release": "bun scripts/release.ts",
    "smoke:celld": "bun scripts/celld-smoke.ts",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "docs:dev": "bun run --filter website dev",
    "docs:build": "bun run --filter website build",
    "docs:verify": "bun run --filter website verify",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsdown": "^0.23.0",
    "typescript": "^7",
    "ultracite": "7.12.2"
  }
}
